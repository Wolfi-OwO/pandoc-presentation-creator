* text=auto

# Keep shell scripts LF-only so shebang works on Linux containers.
*.sh text eol=lf
scripts/* text eol=lf
**/buildPDF text eol=lf

# YAML and Markdown should also stay LF for reproducible container builds.
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows scripts keep CRLF if added in future.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
