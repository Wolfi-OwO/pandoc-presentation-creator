{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 120],

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },


  "yaml.schemas": {
    ".vscode/schemas/pandoc-metadata.json": [
      "metadata.yaml",
      "templates/metadata.yaml.template",
      "**/metadata.yaml",
      "**/defaults/*.yaml"
    ]
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "yaml.customTags": [
    "!include scalar",
    "!reference sequence"
  ],
  "files.associations": {
    "metadata.yaml": "yaml",
    "*.yaml.template": "yaml"
  },

  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/output": true
  },

  "search.exclude": {
    "**/output": true,
    "**/*.pdf": true
  },

  "markdown.preview.breaks": true,
  "markdown.preview.typographer": true
}
