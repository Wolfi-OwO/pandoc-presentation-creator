{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Presentation PDF",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceFolder}:/data",
        "--entrypoint=/bin/sh",
        "pandoc-beamer:local",
        "-c",
        "/data/buildPDF"
      ],
      "dependsOn": ["Build Beamer Docker Image"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build Beamer Docker Image",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        "-f",
        "docker/Dockerfile.beamer",
        "-t",
        "pandoc-beamer:local",
        "."
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Render Minimalist Presentation",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceFolder}:/data",
        "--entrypoint=/bin/sh",
        "-e",
        "INPUT_FILE=/data/slides/Minimalist.md",
        "-e",
        "OUTPUT_FILE=/data/output/presentation.pdf",
        "pandoc-beamer:local",
        "-c",
        "/data/buildPDF"
      ],
      "dependsOn": ["Build Beamer Docker Image"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clean Output Directory",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "output/*"],
      "problemMatcher": []
    },
    {
      "label": "Run Local Tests",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceFolder}:/data",
        "--entrypoint=/bin/sh",
        "-e",
        "INPUT_FILE=/data/slides/Minimalist.md",
        "-e",
        "OUTPUT_FILE=/data/output/test-presentation.pdf",
        "pandoc-beamer:local",
        "-c",
        "/data/buildPDF && echo 'PDF generated successfully'"
      ],
      "dependsOn": ["Build Beamer Docker Image"],
      "problemMatcher": []
    }
  ]
}
