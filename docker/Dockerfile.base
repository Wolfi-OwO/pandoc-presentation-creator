# ==============================================================================
# Dockerfile.base - Base Image with Core Tools
# ==============================================================================
# Multi-stage base image that serves as foundation for other Dockerfile types.

# Stage 1: Pandoc Binary
FROM alpine:3.19 AS pandoc-fetcher
ARG PANDOC_VERSION=3.1.11
RUN apk add --no-cache wget && \
    wget -qO- https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz | \
    tar xz --strip-components=2 -C /usr/local/bin/ "pandoc-${PANDOC_VERSION}/bin/pandoc"

# Stage 2: Base Runtime
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-yaml \
    git \
    wget \
    ca-certificates \
    make \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pandoc-fetcher /usr/local/bin/pandoc /usr/local/bin/pandoc

WORKDIR /data

# ------------------------------------------------------------------------------
# Image Informationen
# ------------------------------------------------------------------------------
# Size: varies with installed packages
# Base: Debian Bookworm Slim
# Pandoc Version: 3.1.11
# Includes: core tools (python, git, make) + pandoc
# Working Directory: /data
