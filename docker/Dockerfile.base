# ==============================================================================
# Dockerfile.base - Minimales Pandoc Base Image
# ==============================================================================
# Dieses Image enthält nur Pandoc und grundlegende Abhängigkeiten.
# Es dient als Basis für spezialisierte Images und kann auch standalone verwendet
# werden für einfache Markdown-Konvertierungen.
#
# Build:  docker build -f docker/Dockerfile.base -t pandoc-base:latest .
# Usage:  docker run --rm -v $(pwd):/data pandoc-base slides.md -o output.html

# ------------------------------------------------------------------------------
# Build Stage: Pandoc Installation
# ------------------------------------------------------------------------------
FROM alpine:3.19 AS builder

# Metadata
LABEL maintainer="koflerphillip@outlook.com"
LABEL org.opencontainers.image.source="https://gitlab.com/woofi4/public/pandoc-presentation-creator"
LABEL org.opencontainers.image.description="Minimal Pandoc base image for document conversion"

# Build arguments
ARG PANDOC_VERSION=3.1.11

# Install build dependencies
RUN apk add --no-cache \
    wget \
    ca-certificates

# Download and install Pandoc
RUN wget -q "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && tar xzf "pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && mv "pandoc-${PANDOC_VERSION}/bin/pandoc" /usr/local/bin/ \
    && rm -rf "pandoc-${PANDOC_VERSION}" "pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz"

# ------------------------------------------------------------------------------
# Final Stage: Minimal Runtime Image
# ------------------------------------------------------------------------------
FROM alpine:3.19

# Copy pandoc binary from builder
COPY --from=builder /usr/local/bin/pandoc /usr/local/bin/pandoc

# Install runtime dependencies with optional packages
RUN apk add --no-cache \
    # Core dependencies
    gmp \
    libffi \
    lua5.3 \
    ca-certificates \
    zlib \
    # Fonts and graphics
    fontconfig \
    freetype \
    ttf-dejavu \
    ttf-liberation \
    # Text processing and utilities
    wget \
    curl \
    git \
    # PDF and image processing
    ghostscript \
    imagemagick \
    # Additional tools
    make \
    patch \
    zip \
    unzip \
    tar \
    gzip \
    # Python for filters
    python3 \
    py3-pip \
    # Development tools (optional)
    nodejs \
    npm

# Install useful Python packages for pandoc filters
RUN pip3 install --no-cache-dir \
    pyyaml \
    click

# Erstelle non-root User für Sicherheit
RUN addgroup -g 1000 pandoc && \
    adduser -D -u 1000 -G pandoc pandoc

# Arbeitsverzeichnis
WORKDIR /data

# Volume für Input/Output
VOLUME ["/data"]

# Wechsel zu non-root User
USER pandoc

# Entrypoint
ENTRYPOINT ["pandoc"]

# Default: Version anzeigen (wenn keine Argumente übergeben werden)
CMD ["--version"]

# ------------------------------------------------------------------------------
# Image Informationen
# ------------------------------------------------------------------------------
# Size: ~40 MB
# Base: Alpine Linux
# Pandoc Version: 3.1.11
# User: non-root (pandoc:1000)
# Working Directory: /data
