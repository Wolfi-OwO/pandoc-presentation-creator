# ==============================================================================
# Dockerfile.beamer - Beamer/LaTeX PDF Presentation Image
# ==============================================================================
# This image contains Pandoc and a modern LaTeX installation for generating
# PDF presentations using the Beamer document class with Metropolis theme.
# Optimized with professional fonts and clean design.
#
# Build: docker build -f docker/Dockerfile.beamer -t pandoc-beamer:latest .
# Usage: docker run --rm -v $(pwd):/data --user root pandoc-beamer:local \
#          --defaults /opt/pandoc/defaults/beamer.yaml /data/slides/example.md -o /data/output/example.pdf

# Stage 1: Pandoc Binary Extractor
FROM alpine:3.19 AS pandoc-fetcher
ARG PANDOC_VERSION=3.1.11
RUN apk add --no-cache wget && \
    wget -qO- https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz | \
    tar xz --strip-components=2 -C /usr/local/bin/ "pandoc-${PANDOC_VERSION}/bin/pandoc"

# Stage 2: Final Runtime (Debian-based for LaTeX compatibility)
FROM debian:bookworm-slim

# Build arguments for metadata
ARG VERSION=unknown
ARG BUILD_DATE
ARG VCS_REF
ARG VCS_URL
ARG PANDOC_VERSION=3.1.11

LABEL maintainer="koflerphillip@outlook.com"
LABEL org.opencontainers.image.source="https://gitlab.com/woofi4/public/pandoc-presentation-creator"
LABEL org.opencontainers.image.description="Pandoc with LaTeX/Beamer support for PDF presentations"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.url="${VCS_URL}"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.pandoc.version="${PANDOC_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive

# Copy Pandoc from builder stage
COPY --from=pandoc-fetcher /usr/local/bin/pandoc /usr/local/bin/pandoc

ARG INSTALL_DEV_TOOLS=false

# Install system + LaTeX dependencies in a single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    git \
    # Core LaTeX packages
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-xetex \
    texlive-luatex \
    # Fonts and typography
    texlive-fonts-recommended \
    texlive-fonts-extra \
    lmodern \
    cm-super \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto \
    fonts-noto-cjk \
    # Graphics and visualization
    texlive-pictures \
    texlive-pstricks \
    texlive-extra-utils \
    graphviz \
    ghostscript \
    imagemagick \
    poppler-utils \
    # PDF processing
    pdftk-java \
    # System tools and utilities
    lua5.3 \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-yaml \
    make \
    patch \
    zip \
    unzip \
    tar \
    gzip \
    file \
    less \
    nano \
    && if [ "$INSTALL_DEV_TOOLS" = "true" ]; then \
      apt-get install -y --no-install-recommends nodejs npm build-essential; \
    fi \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Verify LaTeX/Beamer installation and update font cache
RUN texhash && \
    fc-cache -fv && \
    echo "LaTeX installation verified"

# Install additional beamer themes via tlmgr
RUN tlmgr update --self --all && \
    tlmgr install beamer beamerswitch metropolis inconsolata || true

# Create non-root user
RUN groupadd -g 1000 pandoc && \
    useradd -m -u 1000 -g pandoc pandoc

# Copy project files (only what is needed for beamer)
COPY --chown=pandoc:pandoc core/defaults/ /opt/pandoc/defaults/
COPY --chown=pandoc:pandoc core/metadata/ /opt/pandoc/metadata/
COPY --chown=pandoc:pandoc core/filters/ /opt/pandoc/filters/
COPY --chown=pandoc:pandoc core/includes/ /opt/pandoc/includes/
COPY --chown=pandoc:pandoc core/templates/ /opt/pandoc/templates/
COPY --chown=pandoc:pandoc core/assets/ /opt/pandoc/assets/
COPY --chown=pandoc:pandoc scripts/build_beamer.py /opt/pandoc/scripts/build_beamer.py

# Working directory
WORKDIR /data

# Volume for input/output
VOLUME ["/data"]

# Switch to non-root user
USER pandoc

# Environment Variables
ENV PANDOC_DATA_DIR=/opt/pandoc

# Entrypoint
ENTRYPOINT ["pandoc"]

# Default: display version
CMD ["--version"]

# ==============================================================================
# Image Information
# ==============================================================================
# Size: varies with installed packages (TeX Live is large)
# Base: Debian Bookworm Slim
# Pandoc Version: 3.1.11
# LaTeX: XeLaTeX + LuaLaTeX + Beamer with Metropolis theme
# Fonts: Metropolis default (sans-serif modern fonts)
# Includes: defaults, filters, templates, includes, assets
# User: non-root (pandoc:1000)
# Working Directory: /data
# Data Directory: /opt/pandoc
# Dev Tools: optional via INSTALL_DEV_TOOLS=true
#
# Note: If you want a smaller image, you can use TinyTeX (~150 MB),
# but with limited package selection.
