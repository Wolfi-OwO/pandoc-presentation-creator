# ==============================================================================
# Dockerfile.beamer - Beamer/LaTeX PDF Presentation Image
# ==============================================================================
# This image contains Pandoc and a minimal LaTeX installation for generating
# PDF presentations using the Beamer document class. Optimized for size while
# ensuring stability.
#
# Build: docker build -f docker/Dockerfile.beamer -t pandoc-beamer:latest .
# Usage: docker run --rm -v $(pwd):/data pandoc-beamer python3 scripts/build.py --input slides.md

# Stage 1: Pandoc Binary Extractor
FROM alpine:3.19 AS pandoc-fetcher
ARG PANDOC_VERSION=3.1.11
RUN apk add --no-cache wget && \
    wget -qO- https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz | \
    tar xz --strip-components=2 -C /usr/local/bin/ "pandoc-${PANDOC_VERSION}/bin/pandoc"

# Stage 2: Final Runtime (Debian-based for LaTeX compatibility)
FROM debian:bookworm-slim

LABEL maintainer="koflerphillip@outlook.com"
LABEL org.opencontainers.image.source="https://gitlab.com/woofi4/public/pandoc-presentation-creator"
LABEL org.opencontainers.image.description="Pandoc with LaTeX/Beamer support for PDF presentations"

ENV DEBIAN_FRONTEND=noninteractive

# Copy Pandoc from builder stage
COPY --from=pandoc-fetcher /usr/local/bin/pandoc /usr/local/bin/pandoc

# Install system dependencies first
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install LaTeX + Beamer dependencies with comprehensive packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # Core LaTeX packages
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-xetex \
    texlive-luatex \
    # Fonts and typography
    texlive-fonts-recommended \
    texlive-fonts-extra \
    lmodern \
    cm-super \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto \
    fonts-noto-cjk \
    # Graphics and visualization
    texlive-pictures \
    texlive-pstricks \
    texlive-extra-utils \
    graphviz \
    ghostscript \
    imagemagick \
    poppler-utils \
    # PDF processing
    pdftk-java \
    # System tools and utilities
    lua5.3 \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-yaml \
    make \
    patch \
    zip \
    unzip \
    tar \
    gzip \
    wget \
    curl \
    git \
    file \
    less \
    nano \
    # Development tools (optional)
    nodejs \
    npm \
    build-essential \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Update Beamer to latest version from CTAN
RUN mkdir -p /tmp/beamer && \
    cd /tmp/beamer && \
    wget -q https://mirrors.ctan.org/macros/latex/contrib/beamer.zip && \
    unzip -q beamer.zip && \
    cd beamer && \
    mkdir -p /usr/share/texlive/texmf-dist/tex/latex/beamer-updated && \
    cp -r * /usr/share/texlive/texmf-dist/tex/latex/beamer-updated/ && \
    # Replace old beamer files
    rm -rf /usr/share/texlive/texmf-dist/tex/latex/beamer/* && \
    cp -r /usr/share/texlive/texmf-dist/tex/latex/beamer-updated/* /usr/share/texlive/texmf-dist/tex/latex/beamer/ && \
    texhash && \
    cd / && \
    rm -rf /tmp/beamer

# Install Metropolis Beamer Theme
RUN mkdir -p /tmp/metropolis && \
    cd /tmp/metropolis && \
    wget -q https://github.com/matze/mtheme/archive/refs/heads/master.zip && \
    unzip -q master.zip && \
    cd mtheme-master && \
    mkdir -p /usr/share/texlive/texmf-dist/tex/latex/beamertheme-metropolis && \
    cp *.sty /usr/share/texlive/texmf-dist/tex/latex/beamertheme-metropolis/ && \
    texhash && \
    cd / && \
    rm -rf /tmp/metropolis

# Erstelle non-root User
RUN groupadd -g 1000 pandoc && \
    useradd -m -u 1000 -g pandoc pandoc

# Kopiere Projekt-Dateien (nur was für beamer benötigt wird)
COPY --chown=pandoc:pandoc core/defaults/beamer.yaml /pandoc/defaults/
COPY --chown=pandoc:pandoc core/metadata/ /pandoc/metadata/
COPY --chown=pandoc:pandoc core/filters/ /pandoc/filters/
COPY --chown=pandoc:pandoc core/includes/ /pandoc/includes/

# Arbeitsverzeichnis
WORKDIR /data

# Volume für Input/Output
VOLUME ["/data"]

# Wechsel zu non-root User
USER pandoc

# Environment Variables
ENV PANDOC_DATA_DIR=/pandoc

# Entrypoint
ENTRYPOINT ["pandoc"]

# Default: Version anzeigen
CMD ["--version"]

# ------------------------------------------------------------------------------
# Image Informationen
# ------------------------------------------------------------------------------
# Size: ~250 MB (minimal LaTeX setup)
# Base: Debian Bookworm Slim
# Pandoc Version: 3.1.11
# LaTeX: XeLaTeX + Beamer
# Includes: Beamer defaults, filters, templates
# User: non-root (pandoc:1000)
# Working Directory: /data
# Data Directory: /pandoc
#
# Note: Wenn Sie eine noch kleinere Image-Größe benötigen,
# können Sie auf tinytex umsteigen (~150 MB), aber mit
# eingeschränkter Paket-Auswahl.
