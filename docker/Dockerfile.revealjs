# ==============================================================================
# Dockerfile.revealjs - Reveal.js Presentation Image
# ==============================================================================
# This image contains Pandoc + Node.js + Reveal.js for interactive
# HTML presentations. Optimized for fast web presentations with modern theme.
#
# Build:  docker build -f docker/Dockerfile.revealjs -t pandoc-revealjs:latest .
# Usage:  docker run --rm -v $(pwd):/data pandoc-revealjs \
#           --defaults /opt/pandoc/defaults/revealjs.yaml slides.md -o slides.html

# ==============================================================================
# Build Stage 1: Pandoc Binary
# ==============================================================================
FROM alpine:3.19 AS pandoc-builder

ARG PANDOC_VERSION=3.1.11

RUN apk add --no-cache wget ca-certificates \
    && wget -q "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && tar xzf "pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && mv "pandoc-${PANDOC_VERSION}/bin/pandoc" /usr/local/bin/ \
    && rm -rf "pandoc-${PANDOC_VERSION}" "pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz"

# ==============================================================================
# Build Stage 2: Node.js Dependencies (optional for Reveal.js extensions)
# ==============================================================================
FROM node:20-alpine AS node-builder

# Working directory for Node packages
WORKDIR /app

# Install minimal required Node packages (optional, for advanced features)
# You can add Reveal.js plugins or tools here
RUN npm install -g reveal-md@6.0.0 || true

# ==============================================================================
# Final Stage: Reveal.js Runtime Image
# ==============================================================================
FROM alpine:3.19

# Metadata
LABEL maintainer="koflerphillip@outlook.com"
LABEL org.opencontainers.image.source="https://gitlab.com/woofi4/public/pandoc-presentation-creator"
LABEL org.opencontainers.image.description="Pandoc with Reveal.js support for HTML presentations"

# Copy Pandoc from builder
COPY --from=pandoc-builder /usr/local/bin/pandoc /usr/local/bin/pandoc

# Copy Node.js (runtime only, no build tools)
COPY --from=node-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=node-builder /usr/lib /usr/lib

# Install runtime dependencies with optional packages
RUN apk add --no-cache \
    # Core dependencies
    gmp \
    libffi \
    lua5.3 \
    ca-certificates \
    zlib \
    libstdc++ \
    # Fonts and graphics
    fontconfig \
    freetype \
    ttf-dejavu \
    ttf-liberation \
    # Web and HTTP support
    ca-certificates \
    # Text processing and utilities
    wget \
    curl \
    git \
    file \
    less \
    nano \
    vim \
    # Image processing
    graphviz \
    imagemagick \
    ghostscript \
    poppler \
    poppler-utils \
    # Tools and utilities
    make \
    patch \
    zip \
    unzip \
    tar \
    gzip \
    bzip2 \
    xz \
    # Python support for filters
    python3 \
    py3-pip \
    py3-setuptools \
    py3-yaml \
    py3-click \
    # JavaScript and Node support
    npm \
    nodejs \
    # Development tools
    build-base \
    openssl-dev

# Create non-root user
RUN addgroup -g 1000 pandoc && \
    adduser -D -u 1000 -G pandoc pandoc

# Copy project files (only what is needed for revealjs)
COPY --chown=pandoc:pandoc core/defaults/revealjs.yaml /pandoc/defaults/revealjs.yaml
COPY --chown=pandoc:pandoc core/metadata/ /pandoc/metadata/
COPY --chown=pandoc:pandoc core/filters/ /pandoc/filters/
COPY --chown=pandoc:pandoc core/includes/ /pandoc/includes/

# Working directory
WORKDIR /data

# Volume for input/output
VOLUME ["/data"]

# Switch to non-root user
USER pandoc

# Environment variables
ENV PANDOC_DATA_DIR=/pandoc

# Entrypoint (Pandoc with access to /pandoc directory)
ENTRYPOINT ["pandoc"]

# Default: display version
CMD ["--version"]

# ==============================================================================
# Image Information
# ==============================================================================
# Size: varies with installed packages
# Base: Alpine Linux + Node.js runtime
# Pandoc Version: 3.1.11
# Node Version: 20
# Theme: Reveal.js Moon (modern, elegant)
# Includes: defaults, metadata, filters, includes
# User: non-root (pandoc:1000)
# Working Directory: /data
# Data Directory: /pandoc
